# --- Local development (demo, no Supabase) ---
VITE_DEMO_MODE=true

# Base URL for reassignment email links (production). Demo uses window.location.origin.
# VITE_APP_URL=https://optica.vercel.app

# --- Production / Supabase (set on Vercel too) ---
# VITE_DEMO_MODE=false
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Edge Function send-reassignment-email (Supabase secrets, not Vite):
# RESEND_API_KEY=re_...
# RESEND_FROM=Optica <noreply@yourdomain.com>

# Never expose in the frontend (SQL Editor / migrations only):
# SUPABASE_SERVICE_ROLE_KEY=...
